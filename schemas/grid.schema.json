{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grid.schema.json",
  "title": "scans/<label>/grid.json (docs/06 §6)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "synthetic", "provider", "endpoint", "params", "keywords", "points",
               "complete", "cost_usd", "created"],
  "properties": {
    "schema_version": {"const": 1},
    "synthetic": {"type": "boolean"},
    "provider": {"type": "string", "minLength": 1},
    "endpoint": {"type": "string", "minLength": 1},
    "params": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grid_size", "spacing_km", "center", "device", "language", "depth"],
      "properties": {
        "grid_size": {"type": "integer", "minimum": 1},
        "spacing_km": {"type": "number", "exclusiveMinimum": 0},
        "center": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}],
                   "minItems": 2, "maxItems": 2},
        "device": {"enum": ["mobile", "desktop"]},
        "language": {"type": "string"},
        "depth": {"type": "integer", "minimum": 1},
        "zoom": {"type": "string", "pattern": "^[0-9]{1,2}z$"}
      }
    },
    "mode": {"enum": ["grid", "keywords-probe"]},
    "client_match": {
      "description": "confirmed = client.yaml place_id; unconfirmed = name/phone fallback awaiting a human (questions.md); not_found = client not seen",
      "enum": ["confirmed", "unconfirmed", "not_found"]
    },
    "failures": {"type": "array", "items": {"type": "string"}},
    "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "points": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row", "col", "lat", "lng", "results"],
        "properties": {
          "row": {"type": "integer", "minimum": 0},
          "col": {"type": "integer", "minimum": 0},
          "lat": {"type": "number", "minimum": -90, "maximum": 90},
          "lng": {"type": "number", "minimum": -180, "maximum": 180},
          "distance_km": {"type": "number", "minimum": 0},
          "results": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["client_rank", "status"],
              "properties": {
                "client_rank": {"type": ["integer", "null"], "minimum": 1},
                "top3": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
                "status": {"enum": ["ok", "error"]},
                "error": {"type": "string"},
                "raw": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "client_place_id": {"type": ["string", "null"]},
    "places": {
      "description": "Details for every place_id seen in the scan (client and competitors), from provider data.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "primary_category": {"type": ["string", "null"]},
          "rating": {"type": ["number", "null"], "minimum": 0, "maximum": 5},
          "reviews": {"type": ["integer", "null"], "minimum": 0},
          "website": {"type": ["string", "null"]},
          "lat": {"type": ["number", "null"]},
          "lng": {"type": ["number", "null"]}
        }
      }
    },
    "organic": {
      "description": "Organic Google positions of the client's domain at named check points.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point", "lat", "lng", "keyword", "position", "status"],
        "properties": {
          "point": {"type": "string", "minLength": 1},
          "lat": {"type": "number"},
          "lng": {"type": "number"},
          "keyword": {"type": "string", "minLength": 1},
          "position": {"type": ["integer", "null"], "minimum": 1},
          "status": {"enum": ["ok", "error"]}
        }
      }
    },
    "complete": {"type": "boolean"},
    "cost_usd": {"type": "number", "minimum": 0},
    "created": {"type": "string", "minLength": 10}
  }
}
