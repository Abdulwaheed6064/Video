{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tasks.schema.json",
  "title": "tasks.json and sprint.json (docs/06 §8, states docs/13 §4)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {"const": 1},
    "synthetic": {"type": "boolean"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "day", "agent", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^T[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"},
        "day": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 20},
                          {"type": "string", "pattern": "^m[0-9]{4}-[0-9]{2}-w[1-4]$"}]},
        "agent": {"type": "string", "pattern": "^[a-z]+(-[a-z]+)*$"},
        "title": {"type": "string"},
        "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "status": {"enum": ["pending", "running", "needs_compliance", "awaiting_approval", "applied", "done",
                            "blocked", "skipped"]},
        "outputs": {"type": "array", "items": {"type": "string"}},
        "requires_approval": {"enum": ["gbp_apply_batch", "site_deploy", "post_publish", "review_reply",
                                       "review_kit", "citation_update", "report_send"]},
        "approval_id": {"type": ["string", "null"]},
        "compliance_loops": {"type": "integer", "minimum": 0, "maximum": 2},
        "reason": {"type": "string", "minLength": 1},
        "human_action": {"type": "string", "minLength": 1},
        "updated": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "blocked"}}},
         "then": {"required": ["reason", "human_action"]}},
        {"if": {"properties": {"status": {"const": "skipped"}}},
         "then": {"required": ["reason"]}}
      ]
    }
  }
}
