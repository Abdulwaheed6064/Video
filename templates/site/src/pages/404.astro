---
import Base from '../layouts/Base.astro';
import config from '../../site.config.json';
---
<Base title={`Page not found | ${config.business.name}`} description="This page does not exist." path="/404/" noindex>
  <h1>Page not found</h1>
  <p>That page doesn't exist. <a href="/">Go to the home page</a> or call <a href={`tel:${config.business.phone_tel}`}>{config.business.phone_display}</a>.</p>
</Base>
